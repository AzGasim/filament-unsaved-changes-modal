{
    "name": "azgasim/filament-unsaved-changes-modal",
    "type": "library",
    "description": "Filament plugin: unsaved-changes prompts as Filament modals instead of browser confirm dialogs (Filament v5).",
    "keywords": [
        "AzGasim",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-unsaved-changes-modal",
        "unsaved-changes",
        "unsaved-changes-alert",
        "modal",
        "livewire"
    ],
    "homepage": "https://github.com/azgasim/filament-unsaved-changes-modal",
    "support": {
        "issues": "https://github.com/azgasim/filament-unsaved-changes-modal/issues",
        "source": "https://github.com/azgasim/filament-unsaved-changes-modal"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Aziz Gasim",
            "email": "104441723+AzGasim@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "AzGasim\\FilamentUnsavedChangesModal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AzGasim\\FilamentUnsavedChangesModal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest --no-coverage",
        "test:coverage": "pest --coverage",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AzGasim\\FilamentUnsavedChangesModal\\FilamentUnsavedChangesModalServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}